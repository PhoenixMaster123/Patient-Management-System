<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pm</groupId>
    <artifactId>patient-management-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Patient Management System</name>
    <description>
        Healthcare microservices for patient records, billing, authentication and
        analytics, communicating over REST, gRPC and Kafka behind an API gateway.
    </description>

    <!--
      Aggregator only: every module keeps spring-boot-starter-parent as its parent, so
      nothing inherited changes. It exists so the repository imports as one Maven project,
      which is what puts target/generated-sources/protobuf on the IDE source path.
      Note: `mvn test` also runs integration-tests, which expects a running stack.
    -->
    <modules>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>patient-service</module>
        <module>billing-service</module>
        <module>analytics-service</module>
        <module>infrastructure</module>
        <module>integration-tests</module>
    </modules>

    <build>
        <plugins>
            <!--
              Children inherit from spring-boot-starter-parent, not from this POM, so a
              plugin declared here would not reach them. Point Checkstyle at every module's
              sources instead, and one `mvn checkstyle:check` at the root covers the repo.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>10.21.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <!-- checkstyle.xml uses severity "warning"; flip both to fail the build. -->
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/api-gateway/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/auth-service/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/patient-service/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/billing-service/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/analytics-service/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/infrastructure/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/integration-tests/src/main/java</sourceDirectory>
                    </sourceDirectories>
                </configuration>
            </plugin>

            <!--
              PMD skips a "pom" project outright, so unlike Checkstyle it cannot be aimed at
              the module sources from here. Use the aggregate goals, which walk the reactor:
              `mvn pmd:aggregate-pmd-check` — note no -N, since it needs the other modules.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.26.0</version>
                <configuration>
                    <rulesets>
                        <ruleset>checkstyle/pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <targetJdk>21</targetJdk>
                    <printFailingErrors>true</printFailingErrors>
                    <!-- Reports without breaking the build, matching Checkstyle. -->
                    <failOnViolation>false</failOnViolation>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
